# Database Configuration (Block A)
DATABASE_URL=postgresql://user:password@localhost:5432/plane_db?sslmode=require

# Optional: Offline Storage (Block B - Future)
# ENABLE_OFFLINE_MODE=true
# ENABLE_CRDT_SYNC=false

# Server Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Feature Flags
VITE_ENABLE_SESSION_RECORDER=0
VITE_ENABLE_OFFLINE_MODE=0
VITE_ENABLE_REAL_TIME_SYNC=0

# Analytics (Optional)
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=

# Authentication (Optional)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
